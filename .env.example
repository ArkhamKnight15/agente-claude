# ─────────────────────────────────────────────────────────────
# Prospecta — variáveis de ambiente (copie para .env e preencha)
# Nunca versione o .env. Segredos ficam apenas no servidor.
# ─────────────────────────────────────────────────────────────

# Banco de dados PostgreSQL (obrigatório)
DATABASE_URL="postgresql://prospecta:SENHA@localhost:5432/prospecta?schema=public"
# Conexão direta para migrações quando DATABASE_URL usa pooler (Neon, Supabase…).
# Na Vercel + Neon, DATABASE_URL_UNPOOLED já é criada pela integração e também é aceita.
DIRECT_DATABASE_URL=""

# URL pública da aplicação (usada em links de descadastro e no webhook)
APP_URL="http://localhost:3000"
# Segredo com 32+ caracteres (assina tokens e protege a lista de supressão). Gere com: openssl rand -hex 32
APP_SECRET=""
SESSION_TTL_DAYS=7

# Primeiro administrador (usado apenas por `npm run db:seed` quando não há usuários)
ADMIN_EMAIL="voce@suaempresa.com.br"
ADMIN_PASSWORD=""
ADMIN_NAME="Seu nome"

# ── IA (Claude API) — opcional; sem chave, o agente usa modelos de mensagem padrão ──
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-opus-5-5"
# low | medium | high | xhigh | max
LLM_EFFORT="medium"

# ── Fontes de empresas ──
# Google Places API (New): https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=""
PLACES_DAILY_LIMIT=300
# OpenStreetMap / Overpass (gratuito, sem chave)
OSM_ENABLED=true
OVERPASS_URL="https://overpass-api.de/api/interpreter"
OSM_CONTACT_EMAIL=""

# ── Busca web para confirmar ausência de site (escolha um) ──
# brave | serper | google_cse  (vazio = primeiro com chave configurada)
SEARCH_PROVIDER=""
BRAVE_SEARCH_API_KEY=""
SERPER_API_KEY=""
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_CX=""
SEARCH_DAILY_LIMIT=200

# ── WhatsApp Business Platform (Cloud API oficial da Meta) ──
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v23.0"
# Modelo aprovado para iniciar conversas e ordem das variáveis {{1}}, {{2}}…
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
# Valores possíveis: lead_name, city, sender_name, sender_company
WHATSAPP_TEMPLATE_PARAMS="lead_name"

# ── E-mail (envio por SMTP e leitura de respostas por IMAP) ──
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Seu Nome <voce@suaempresa.com.br>"
EMAIL_REPLY_TO=""
IMAP_HOST=""
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"

# ── Worker / execução serverless ──
# Segredo exigido pelo endpoint /api/cron/run-jobs (Cron da Vercel ou agendador externo). Gere com: openssl rand -hex 32
CRON_SECRET=""
# Processa a fila logo após cada ação (padrão: ligado na Vercel, desligado com worker dedicado)
# QUEUE_INLINE=true
# Tempo máximo de cada parte da pesquisa de empresas (ms)
JOB_SLICE_MS=90000
WORKER_CONCURRENCY=3
WORKER_POLL_MS=1500
# debug | info | warn | error
LOG_LEVEL="info"
