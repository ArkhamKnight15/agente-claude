# ── Obrigatórias ──
# Banco Postgres (na Vercel: Storage → Neon → Connect Project cria esta variável sozinha).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/prospecta"
# Senha de acesso ao app (mínimo 8 caracteres). Trocar a senha desconecta todos os aparelhos.
APP_PASSWORD=""

# ── Busca de empresas ──
# Google Places API (New). Sem chave, a busca usa o OpenStreetMap (gratuito, cobertura menor).
GOOGLE_PLACES_API_KEY=""
# Máximo de consultas ao Google por dia (cada consulta traz até 20 empresas). 30/dia ≈ cota gratuita do mês.
PLACES_DAILY_LIMIT=30
# Servidores do OpenStreetMap (separados por vírgula; se um falhar, usa o próximo).
# OVERPASS_URL="https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter"
# E-mail de contato enviado ao OpenStreetMap para identificar o tráfego (opcional).
OSM_CONTACT_EMAIL=""
